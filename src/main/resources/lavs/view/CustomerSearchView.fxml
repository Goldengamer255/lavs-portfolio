<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<VBox prefHeight="600.0" prefWidth="900.0" spacing="16.0" styleClass="screen" xmlns="http://javafx.com/javafx/17.0.18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.CustomerSearchController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <Label fx:id="titleLabel" styleClass="screen-title" text="Customers" />
      <HBox alignment="BOTTOM_LEFT" spacing="12.0">
         <children>
            <VBox prefWidth="420.0" spacing="4.0">
               <children>
                  <Label styleClass="field-label" text="Search by customer name" />
                  <TextField fx:id="searchField" promptText="e.g. Smith" />
               </children>
            </VBox>
            <Button fx:id="searchButton" defaultButton="true" mnemonicParsing="false" onAction="#handleSearch" styleClass="secondary-button" text="Search" />
            <ProgressIndicator fx:id="searchSpinner" prefHeight="20.0" prefWidth="20.0" visible="false" />
               <VBox prefWidth="160.0" spacing="4.0">
               <children>
                  <Label styleClass="field-label" text="Open loan by number" />
                  <TextField fx:id="loanNumberField" promptText="Loan number" />
               </children>
            </VBox>
            <Button fx:id="openLoanButton" mnemonicParsing="false" onAction="#handleOpenLoan" styleClass="secondary-button" text="Open Loan" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="addCustomerButton" mnemonicParsing="false" onAction="#handleAddCustomer" styleClass="primary-button" text="+ Add New Customer" />
            <Button fx:id="cancelPickButton" mnemonicParsing="false" onAction="#handleCancelPick" styleClass="secondary-button" text="Cancel" visible="false" />
         </children>
      </HBox>
      <TableView fx:id="customerTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="numberColumn" prefWidth="75.0" text="Customer No." />
          <TableColumn fx:id="nameColumn" prefWidth="75.0" text="Name" />
            <TableColumn fx:id="titleColumn" prefWidth="75.0" text="Title" />
            <TableColumn fx:id="dobColumn" prefWidth="75.0" text="Date of Birth" />
            <TableColumn fx:id="statusColumn" prefWidth="75.0" text="Status" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label fx:id="resultCountLabel" styleClass="hint-text" text="Search for a customer by name, or add a new one." />
   </children>
</VBox>
