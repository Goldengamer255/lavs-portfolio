<?xml version="1.0" encoding="UTF-8"?>

<!-- AI-assisted: Used scene builder to create the layout, then adjusted for the team's needs. Adapted the team's dialog layout for document metadata and field errors. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="520.0" spacing="8" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
  <children>
    <Label text="File name" />
    <TextField fx:id="fileNameField" promptText="proof.pdf" />
    <Label fx:id="fileNameError" styleClass="field-error" visible="false" />
    <Label text="File type" />
    <TextField fx:id="fileTypeField" promptText="application/pdf" />
    <Label fx:id="fileTypeError" styleClass="field-error" visible="false" />
    <Label text="Size (bytes)" />
    <TextField fx:id="sizeField" promptText="0" />
    <Label fx:id="sizeError" styleClass="field-error" visible="false" />
    <Label text="Document type" />
    <TextField fx:id="typeField" promptText="Identity" />
    <Label fx:id="typeError" styleClass="field-error" visible="false" />
    <Label fx:id="errorLabel" managed="false" styleClass="field-error" visible="false" wrapText="true" />
  </children>
</VBox>
