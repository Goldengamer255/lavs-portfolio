<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>


<VBox prefWidth="520.0" spacing="6.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
   </padding>
   <children>
      <VBox spacing="4.0">
         <children>
            <Label styleClass="field-label" text="Subject" />
            <TextField fx:id="typeField" maxWidth="1.7976931348623157E308" />
            <Label fx:id="typeError" styleClass="field-error" text="Error" visible="false" />
         </children>
      </VBox>
      <VBox spacing="4.0">
         <children>
            <Label styleClass="field-label" text="Note" />
            <TextArea fx:id="linesArea" prefRowCount="6" wrapText="true" />
            <Label fx:id="linesError" styleClass="field-error" text="Error" visible="false"/>
         </children>
      </VBox>
      <Label fx:id="formErrorLabel" styleClass="field-error" text="Error" visible="false" wrapText="true" />
   </children>
</VBox>
