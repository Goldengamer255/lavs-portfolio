<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<VBox spacing="8.0" xmlns="http://javafx.com/javafx/17.0.18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.support.EntityListController">
   <padding>
      <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <Button fx:id="addButton" mnemonicParsing="false" onAction="#handleAdd" styleClass="primary-button" text="+ Add" />
            <Button fx:id="editButton" mnemonicParsing="false" onAction="#handleEdit" styleClass="secondary-button" text="Edit" />
            <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#handleDelete" styleClass="secondary-button" text="Delete" />
            <Region HBox.hgrow="ALWAYS" />
            <ProgressIndicator fx:id="listSpinner" prefHeight="20.0" prefWidth="20.0" visible="false" />
         </children>
      </HBox>
      <TableView fx:id="table" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label fx:id="messageLabel" styleClass="hint-text" text="Select a row to edit or delete it." wrapText="true" />
   </children>
</VBox>
