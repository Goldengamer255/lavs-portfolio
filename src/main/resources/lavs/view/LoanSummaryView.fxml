<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="16.0" styleClass="screen" xmlns="http://javafx.com/javafx/17.0.18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.LoanSummaryController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Label fx:id="titleLabel" styleClass="screen-title" text="Loan Summary" />
            <ProgressIndicator fx:id="loadingSpinner" prefHeight="20.0" prefWidth="20.0" visible="false" />
         </children>
      </HBox>
      <Label fx:id="statusLabel" styleClass="field-label" text="Status: New" />
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <Label fx:id="errorLabel" styleClass="field-error" visible="false" wrapText="true" />
            <Button fx:id="retryButton" mnemonicParsing="false" onAction="#handleRetry" styleClass="secondary-button" text="Retry" visible="false" />
         </children>
      </HBox>
      <VBox spacing="12.0" styleClass="card">
         <children>
            <Label styleClass="section-title" text="Loan Summary" />
            <HBox spacing="48.0">
               <children>
                  <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="2.0">
                           <children>
                              <Label styleClass="hint-text" text="Customer" />
                              <Label fx:id="customerValue" styleClass="summary-value" text="-" />
                           </children>
                        </VBox>
                        <VBox spacing="2.0">
                           <children>
                              <Label styleClass="hint-text" text="Final Payment Amount" />
                              <Label fx:id="finalPaymentAmountValue" styleClass="summary-value" text="-" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="2.0">
                           <children>
                              <Label styleClass="hint-text" text="Number of Payments" />
                              <Label fx:id="paymentCountValue" styleClass="summary-value" text="-" />
                           </children>
                        </VBox>
                        <VBox spacing="2.0">
                           <children>
                              <Label styleClass="hint-text" text="Total Interest Paid" />
                              <Label fx:id="totalInterestValue" styleClass="summary-value" text="-" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="2.0">
                           <children>
                              <Label styleClass="hint-text" text="Final Payment Date" />
                              <Label fx:id="finalPaymentDateValue" styleClass="summary-value" text="-" />
                           </children>
                        </VBox>
                        <VBox spacing="2.0">
                           <children>
                              <Label styleClass="hint-text" text="Total Amount Paid" />
                              <Label fx:id="totalPaidValue" styleClass="summary-value" text="-" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <Label styleClass="section-title" text="Repayment Schedule" />
      <TableView fx:id="scheduleTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="paymentNumberColumn" prefWidth="75.0" text="#" />
          <TableColumn fx:id="dateColumn" prefWidth="75.0" text="Date" />
            <TableColumn fx:id="amountPaidColumn" prefWidth="75.0" text="Amount Paid" />
            <TableColumn fx:id="principalColumn" prefWidth="75.0" text="Principal" />
            <TableColumn fx:id="interestColumn" prefWidth="75.0" text="Interest" />
            <TableColumn fx:id="remainingColumn" prefWidth="75.0" text="Remaining" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="‹ Back to Loan" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="prevPageButton" mnemonicParsing="false" onAction="#handlePreviousPage" styleClass="secondary-button" text="‹ Previous" />
            <Label fx:id="pageLabel" styleClass="hint-text" text="Page 1 of 1" />
            <Button fx:id="nextPageButton" mnemonicParsing="false" onAction="#handleNextPage" styleClass="secondary-button" text="Next ›" />
         </children>
      </HBox>
   </children>
</VBox>
